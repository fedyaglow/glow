function validateEmail($email) {
    var emailReg = /^([\w-\.]+@([\w-]+\.)+[\w-]{2,4})?$/;
    console.log(emailReg.test($email));
    return emailReg.test($email);
}

$(function() {
    $('body').on('keyup', '#txtEmailRecipient', function() {
        $('#shareSingleProduct').find('div.help-block.text-danger').text('');
    });
    $('body').on('click', '#sendMailModal', function() {
        $('#shareSingleProduct').find('div.help-block.text-danger').text('');
        //let id_art = $('#id_art').val();
        let platform = $('#mod_acquisto_fieldset').attr('data-platform');
        let url = $(location).attr('pathname');
        let email_recipient = $('#txtEmailRecipient').val();
        let imageProduct = $('.tile').attr('data-image');
        let codeProduct = $('li.breadcrumb-item.active').find('span').text();
        let descriptionProduct = $.trim($('.product-description').text());

        if (!validateEmail(email_recipient)) {
            alert('Email is invalid');
            $('#shareSingleProduct').find('div.help-block.text-danger').text('Mail error!');
            return false;
        }

        //let value = $('#costo').val();
        //let token = $('#token').val();
        if (!platform) platform = 1;
        $('.modal#shareSingleProduct').css('display', '');
        wait('show');
        var details = {
            platform: platform,
            url: url,
            email_recipient: email_recipient,
            imageProduct: imageProduct,
            codeProduct: codeProduct,
            descriptionProduct: descriptionProduct,
        };
        $.ajax({
                url: "/share_single_product",
                type: 'GET',
                data: {
                    details: details,
                },
            })
            .done(function(esito, status, response) {
                wait('hide');
                $('#shareSingleProduct').css('display', 'block');
                if (esito.error != '') {
                    //$('#shareSingleProduct').modal('hide');
                    //error(esito.error);
                    $('.modal#shareSingleProduct').find('div.help-block.text-danger').text(esito.error); //scrivo nella modal di errore con id = err
                } else {
                    wait('hide');
                    $('.modal#shareSingleProduct').css('display', 'block');
                    setTimeout(function() {
                        $('#shareSingleProduct').find('div.help-block.text-success').text('Mail inviata!'); //scrivo nella modal di errore con id = err
                    }, 1);
                    setTimeout(function() {
                        $('#shareSingleProduct').find('div.help-block.text-success').text('');
                    }, 10);
                    $('#txtEmailRecipient').val('');
                    setTimeout(function() { $('#shareSingleProduct').modal('hide') }, 500)
                }
            })
    })
})