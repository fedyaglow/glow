$(function () {
    $("body").on("keypress keyup", ".phone_type", function (event) {
        $(this).val(
            $(this)
                .val()
                .replace(/[^\d].+/, ""),
        );
        if (event.which < 48 || event.which > 57) {
            event.preventDefault();
        }
    });

    $(".alt").tooltip();

    //modal Faq
    $("body").on("click", ".faq", function () {
        wait();
        $("#modal").find(".title").html("");
        $("#modal").find(".content").html("");
        $("#modal").find(".modal-dialog").addClass("modal-lg");
        let id = $(this).attr("alt");
        $.ajax({
            url: "/get-faq-argument/" + id,
            type: "get",
        }).done(function (esito) {
            wait("hide");
            if (esito.argomento != "null") {
                $("#modal").find(".title").html(esito.titolo);
                $("#modal").find(".content").html(esito.argomento);
                $("#modal").modal();
            }
        });
    });

    setTimeout(function () {
        let id_cat = $("#id_cat").val();
        if (parseInt(id_cat) > 0) {
            let parent = $("#subcat_" + id_cat).attr("parent");
            let grandparent = $("#subcat_" + id_cat).attr("grandparent");

            if (grandparent != "") $("#" + grandparent).collapse();
            if (parent != "") $("#" + parent).collapse();
        }
    });

    //Hover loghi Social prefooter
    $(".social_hover").hover(
        function () {
            // Trova l'immagine all'interno del tag <a> passato
            var img_element = $(this).find("img");

            // On mouse enter
            var currentSrc = img_element.attr("src");
            var hoverSrc = img_element.attr("data-hover");
            img_element.attr("src", hoverSrc);
            img_element.attr("data-hover", currentSrc);
        },
        function () {
            // Trova l'immagine all'interno del tag <a> passato
            var img_element = $(this).find("img");

            // On mouse leave
            var currentSrc = img_element.attr("src");
            var hoverSrc = img_element.attr("data-hover");
            img_element.attr("src", hoverSrc);
            img_element.attr("data-hover", currentSrc);
        },
    );

    //Carosello lingue mobile prefooter
    $(".carousel-lang-mobile").owlCarousel({
        loop: false,
        dots: false,
        autoplay: false,
        margin: 10,
        nav: false,
        responsive: {
            0: {
                items: 6,
            },
            374: {
                items: 7,
            },
            424: {
                items: 8,
            },
        },
    });
});

// Log lettura Notifica APP
$(document).ready(function () {
    function getParam(name) {
        const urlParams = new URLSearchParams(window.location.search);
        return urlParams.get(name);
    }

    const nid = getParam("nid");

    if (nid) {
        $.ajax({
            url: "/api/notification/open",
            method: "POST",
            data: { nid: nid },
            success: function () {
                console.log("Notification tracked");
                if (window.history.replaceState) {
                    const url = new URL(window.location);
                    url.searchParams.delete("nid");
                    window.history.replaceState(
                        {},
                        document.title,
                        url.pathname + url.search,
                    );
                }
            },
            error: function () {
                console.log("Tracking error");
            },
        });
    }
});
