function setVideoVolume(player, status) {

    if (!player) {
        console.warn('Player video non trovato');
        return;
    }

    if (status === 'muted') {
        player.volume = 1;
        player.muted = false;
    } else if (status === 'unmuted') {
        player.volume = 0;
        player.muted = true;
    }
}

function setReelContainerHeight() {
    const head = document.getElementById('head');
    const mobileNav = document.querySelector('.menu.overflow-horizontal');
    if(head && mobileNav) {
        const height = parseFloat(mobileNav.offsetHeight) + parseFloat(head.offsetHeight);
        const reelContainer = document.querySelector('.reel-container');
        if(reelContainer) {
            const winHeight = window.innerHeight;
            reelContainer.style.height = (parseFloat(winHeight) - parseFloat(height)) + 'px';
        }
    }
}

document.addEventListener('DOMContentLoaded', ()=>{

    const videos = document.querySelectorAll('.reel');
    videos.forEach(video => {

            // Stop e play dinamico del video in base al view-port
            const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach((entry) => {
                    const video = entry.target;
                    if (entry.isIntersecting) {
                        // Se ha autoplay e non sta già andando, fai partire
                        if (video.hasAttribute('autoplay') && video.paused) {
                            video.play().catch(() => {
                                console.warn(`⚠️ Autoplay fallito per video "${video.id}"`);
                            });
                        }
                    } else {
                        // Metti in pausa se esce dal viewport
                        if (!video.paused) {
                            video.pause();
                        }
                    }
                });
            },
            {
                threshold: 0.5, // almeno il 50% deve essere visibile per attivare
            }
            );
            videos.forEach((video) => observer.observe(video));
            // Fine

            // Se il video è in autoplay parte o si ferma dinamicamente al click
            if (video.hasAttribute('autoplay')) {
                video.addEventListener('click', ()=>{
                    if (video.paused) {
                        video.play().catch((err) => {
                            console.warn(`⚠️ Errore nel riprendere il video:`, err);
                        });
                    } else {
                        video.pause();
                    }
                })
            }
        })

    // Gestione volume
    const volumeButtons = document.querySelectorAll('.volume-container');
    if(volumeButtons) {
        volumeButtons.forEach(button=>{
            const volumeButton = button.querySelector('.volume');
            button.addEventListener('click', ()=>{
                const volumeStatus = volumeButton.getAttribute('data-status');
                if(volumeStatus==='muted') {
                    volumeButton.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-volume2-icon lucide-volume-2"><path d="M11 4.702a.705.705 0 0 0-1.203-.498L6.413 7.587A1.4 1.4 0 0 1 5.416 8H3a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2.416a1.4 1.4 0 0 1 .997.413l3.383 3.384A.705.705 0 0 0 11 19.298z"/><path d="M16 9a5 5 0 0 1 0 6"/><path d="M19.364 18.364a9 9 0 0 0 0-12.728"/></svg>';
                    volumeButton.setAttribute('data-status', 'unmuted');
                } else {
                    volumeButton.innerHTML = '<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-volume-off-icon lucide-volume-off"><path d="M16 9a5 5 0 0 1 .95 2.293"/><path d="M19.364 5.636a9 9 0 0 1 1.889 9.96"/><path d="m2 2 20 20"/><path d="m7 7-.587.587A1.4 1.4 0 0 1 5.416 8H3a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h2.416a1.4 1.4 0 0 1 .997.413l3.383 3.384A.705.705 0 0 0 11 19.298V11"/><path d="M9.828 4.172A.686.686 0 0 1 11 4.657v.686"/></svg>';
                    volumeButton.setAttribute('data-status', 'muted');
                }

                const videoId = volumeButton.getAttribute('data-id');
                const player = document.getElementById(videoId);

                setVideoVolume(player, volumeStatus);
            })
        })
    }
})
