function create_quick_cart(contenitore, id) {
    const quick_alert_master = document.getElementById('quick-alert-master');
    if(quick_alert){
        const quick_alert = quick_alert_master.cloneNode(true);
        contenitore.appendChild(quick_alert);
        quick_alert.id = 'quick_alert_' + id;
    } else {
        console.log('quick-alert-master non presente nel DOM');
    }
}

document.addEventListener('DOMContentLoaded', ()=>{
    const variantButtons = document.querySelectorAll('.change_color');
    if(variantButtons) {
        variantButtons.forEach(ele=>{
            ele.addEventListener('click', ()=>{
                const key = ele.getAttribute('data-key');
                const offcanvas = document.getElementById('offcanvas_'+key);
                if(offcanvas) {
                    offcanvas.classList.add('show');
                }
            })
        })
    }

    const plusBundles = document.querySelectorAll('.plus-bundle');
    if(plusBundles) {
        plusBundles.forEach(ele=>{
            ele.addEventListener('click', ()=>{
                const bKey = ele.getAttribute('data-key');
                const toRemove = document.getElementById('plus_' + bKey);
                if(toRemove) {
                    toRemove.classList.add('hide');
                }
            })
        })
    }

    const closeCanvasButtons = document.querySelectorAll('.close-canvas');
    if(closeCanvasButtons) {
        closeCanvasButtons.forEach(ele=>{
            ele.addEventListener('click', ()=>{
                const key = ele.getAttribute('data-key');
                const offcanvas = document.getElementById('offcanvas_'+key);
                if(offcanvas) {
                    offcanvas.classList.remove('show');
                }
            })
        })
    }

    const add_cart_btns = document.querySelectorAll('.add_promo_to_cart');
    if(add_cart_btns) {
        add_cart_btns.forEach(btn=>{
            btn.addEventListener('click', function() {
                const id = btn.getAttribute('data-id');
                const contenitore = this.closest('.product_promo_card');
                create_quick_cart(contenitore, id)
            });
        })
    }

    const variant_selects = document.querySelectorAll('.product_select_format');
    variant_selects.forEach(ele=>{
        ele.addEventListener('change', ()=>{
            const id = ele.value;
            const contenitore = ele.closest('.off-canvas');
            const btn = contenitore ? contenitore.querySelector('.add_promo_to_cart') : null;
            if(btn) {
                btn.setAttribute('data-id', id);
            }
        })
    })
})

