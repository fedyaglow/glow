function normalizeCardHeights(element) {
    setTimeout(() => {
        let maxHeight = 0;

        // Resetta l'altezza per evitare calcoli errati
        $(element + " .item").css("height", "auto");

        // Trova l'altezza massima tra tutte le card
        $(element + " .item").each(function () {
            let thisHeight = $(this).outerHeight();
            if (thisHeight > maxHeight) {
                maxHeight = thisHeight;
            }
        });

        // Applica l'altezza massima a tutte le card
        $(element + " .item").css("height", maxHeight + "px");
    }, 1250); // Un leggero ritardo per assicurarsi che gli elementi siano renderizzati
}
