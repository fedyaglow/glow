function adjustQuantity($element, increment) {
    let q = parseInt($element.attr("alt")) + increment;
    q = Math.max(1, Math.min(q, 20)); // garantisce che q sia tra 1 e 20
    $element.attr("alt", q).html(q);
    let btn_add = $('.modal-full-button');
    if (btn_add) {
        btn_add.attr("alt", q);
    }
}

