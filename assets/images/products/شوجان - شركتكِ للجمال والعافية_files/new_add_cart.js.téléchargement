    var last_parent_class = window.last_parent_class || "";

    // funzione riusabile per click/option change
    function openProductModalFrom($src) {
        let parent_class = $src.attr("data-parent-class") || "";       // opzionale nelle option
        let css_class    = $src.attr("data-class") || "day";
        let isBuyable    = $src.attr("data-isBuyable") || 1;
        let key          = $src.attr("data-key") ?? "not_specified";

        // id articolo: da attributo o da value/contesto
        let id_art = $src.attr("idArticolo")
                || $src.val()
                || $src.closest(".product_promo_card").find(".quantity_id_art").val();

        // title: supporta alt4 (bottoni) e alt2 (options)
        let title = $src.attr("alt4") || $src.attr("alt2") || "";

        let inWish     = $src.attr("data-inWishlist")  ?? 0;
        let percentage = $src.attr("data-percentage")  ?? 0;
        let message    = $src.attr("data-message")     ?? 0;
        let multiple   = $src.attr("data-multiple")    ?? 0;
        let qty_min   = $src.attr("data-qty")    ?? 1;

        $("#modal_class").html("");
        $("#modal_class_title").html("");
        if (title !== '') $("#modal_class_title").html(title);

        if (last_parent_class) $(".modal-body").removeClass(last_parent_class);
        if (parent_class)      $(".modal-body").addClass(parent_class);
        last_parent_class = parent_class;

        $.ajax({
            type: "get",
            url: "/get_article/"+id_art+"/"+css_class+"/"+isBuyable+"/"+inWish+"/"+key+"/"+percentage+"/"+qty_min+"/"+message+"/"+multiple,
            dataType: "json",
            success: function (response) {
                $("#modal_class").html(response.html);
                setTimeout(() => {
                    $("#ModalProductContent").modal();
                    // lazyload img[data-src]
                    document.querySelectorAll('img[data-src]').forEach(function(img){
                        img.setAttribute('src', img.getAttribute('data-src'));
                        img.onload = function(){ img.removeAttribute('data-src'); };
                    });
                }, 30);
            }
        });
    }

    // CLICK (tuo handler esistente, riscritto per usare la funzione)
    $("body").on("click", ".show_product_content", function(){
        openProductModalFrom($(this));
    });

    // CHANGE sulla select (usa la option selezionata)
