/**
 * Inizializza tabelle con datatables
 */
function datatableme(selector) {
    if (typeof selector == "undefined") selector = ".to_datatable";

    $(selector).DataTable({
        responsive: true,
        colReorder: true,
        paging: true,
        pagingType: "simple_numbers",
        language: {
            url: "/assets/plugins/data-tables/json/it.json"
        },
        aoColumnDefs: [
            {
                bSortable: false,
                aTargets: ["nosort"]    //classe da aggiungere al th della colonna da non ordinare da non ordinare
            }
        ]
    });
}
