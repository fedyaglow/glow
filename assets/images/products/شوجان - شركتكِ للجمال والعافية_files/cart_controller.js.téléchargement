$(function () {

    //Aggiungi al carrello dalla modal laterale di ricerca prodottti
    $('body').on('click', '.add_cart_single_qty_correlated', function () {
        var id_art = $(this).attr('alt');
        console.log('add_cart ' + id_art);
        add_cart(id_art, 1);
    })
    //Fine

    //Aggiunge al carrello tutti i campioncini mancanti nei CAMP5
    $("body").on("click", "#btn-add-samples-to-cart", function () {
        let samples = $("#txt-default-samples").val();
        $.ajax({
            url: "/add_samples_to_cart",
            type: 'GET',
            data: { samples: samples },
            success: function (response) {
                if (response.status == 1) {
                    location.reload();
                } else {
                    quick_alert("Generic error", "warning");
                }
            },
            error: function (response) {
                quick_alert("Generic error", "warning");
            }
        });
    });

});

function initLucideIcons() {
    if (window.lucide) {
        lucide.createIcons();
    }
}

function reload_shipping_progress_bar() {
    let url = window.location.pathname + window.location.search;

    let $root = $('#shipping-progress-root');

    if (!$root.length) return;

    $root.fadeTo(150, 0.5).load(url + ' #shipping-progress-root > *', function () {
        initLucideIcons();
        $(this).fadeTo(150, 1);
    });
}

// Aggiunge al carrrello e mostra
function add_cart(id_art, qta) {
    var actual_qty = parseInt($(".fast_cart_items").html());
    var new_qty = actual_qty + qta;
    $(".fast_cart_items").html(new_qty);
    $(".add_cart_single_qty, .add_cart_single_qty_correlated").prop("disabled", true);
    $.ajax({
        url: "/add_to_cart",
        type: 'get',
        data: { id_art: id_art, qta: qta },
        success: function (esito) {
            wait('hide');
            if (esito.err == "") {
                var quick_alert_ele = $('#quick_alert_' + id_art);
                if (quick_alert_ele.length) {
                    quick_alert_ele.addClass('show');
                    setTimeout(function () {
                        quick_alert_ele.removeClass('show');
                    }, 1000)

                    setTimeout(function () {
                        quick_alert_ele.remove();
                    }, 3000)
                } else {
                    quick_alert(esito.success);
                }

                $(".add_cart_single_qty, .add_cart_single_qty_correlated").prop("disabled", false);

                var hasCartLive = $("#destinazione_merce").length > 0;

                if (hasCartLive && typeof reload_cart_live === 'function') {
                    reload_cart_live();
                }

                if (typeof reload_cart_fast === 'function') {
                    reload_cart_fast();
                }

                if($("#force_reload_cart").length >0){
                    location.reload();
                }

            } else {
                quick_alert(esito.err, "warning");
                $(".add_cart_single_qty, .add_cart_single_qty_correlated").prop("disabled", false);
                console.log('Aggiunto al carrello ' + id_art);
            }
        },
        error: function () {
            wait('hide');
            quick_alert("Generic error", "warning");
            $(".add_cart_single_qty, .add_cart_single_qty_correlated").prop("disabled", false);
        }
    });
}

