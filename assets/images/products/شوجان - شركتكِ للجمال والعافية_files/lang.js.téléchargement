$(function(){

    //View lang page
    $("body").on('click','.lang',function(){
        $("#menu_lang").slideToggle('fast');
    })
    //Fine

    //Set language
    $('body').on('click','.btn_lingua',function() {
        var id = $(this).attr('alt');
        $.get(base_name+'view/lang/translate.php',{sbm_cng_lang:id},function(esito){
            if(esito=='done') location.reload();
        })
    })
    //fine

    $('#lang-menu').on('click', function(){
        $(this).removeClass('show');
    })

})
