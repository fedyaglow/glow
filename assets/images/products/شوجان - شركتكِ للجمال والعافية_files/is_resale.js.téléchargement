function EnableisResale() {
	$.ajax({
		type: "get",
		url: "/get_your_identity",
		success: function () {
			location.href="/chogangroup/dropshipping-address-select";
		}
	});
};

function DisableisResale() {
	$.ajax({
		type: "get",
		url: "/get_your_identity",
		success: function (response) {
			success(response.success,function(){
				location.href="/chogangroup/dropshipping-address-select";
			})
		}
	});
};
