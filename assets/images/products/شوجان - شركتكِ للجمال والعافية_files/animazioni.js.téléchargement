//Animazione di base
function show(div,effect,time) {
	setTimeout(function(){
		$(div).css('visibility','visible');
		$(div).addClass(effect);
	},time)
	$(div).removeClass(effect);
}

function hide(div,effect,time) {
	setTimeout(function(){
		$(div).addClass(effect);
	},time);
	$(div).css('visibility','hidden');
	$(div).removeClass(effect);
}

//Funzione che visualizza i contenuti del post allo scrolling
function view_on_scroll(div,effect,time) {
	var div_pos = $(div).offset();
	$(window).on('scroll',function() { 
		var my_top = $(this).scrollTop();
		if(my_top>=(div_pos.top-my_top)) {
			show(div,effect,time);
		}
	})
}

//Funzione che applica un effetto animate.css ad un div
function animation(div,effect,time) {
	setTimeout(function(){
        $(div).removeClass('not_visible');
		$(div).addClass('animate__animated animate__'+effect);
	},time)
}

function animate(div,effect,time) {
	var div_pos = $(div).offset();
	$(window).on('scroll',function() { 
