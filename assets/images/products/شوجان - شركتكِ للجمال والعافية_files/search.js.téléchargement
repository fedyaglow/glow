$(function(){

    var id_ricerca = 0;
    var last_search = '';
    var open_default_search_result = '';

	function search(code) {
        if (parseInt(code.length) >= 2) {
            id_ricerca++;
            let now_id_ricerca = id_ricerca;

            if(open_default_search_result!='' && code=='open_default_search_result'){
                let tempDiv = $('<div>').html(open_default_search_result);
                let html_article = tempDiv.find('#article').html();
                let html_news = tempDiv.find('#news').html();
                $("#search_result_list_article").html(html_article);
                $("#search_result_list_news").html(html_news);
                tempDiv.remove();
                return true;
            }

            if(last_search==code) return true;
            last_search=code;

            $.ajax({
                    url: '/' + brand_header + '/search-list/' + code,
                    type: 'GET',
                })
                .done(function (esito) {
                    //Questa cosa folle serve per evitare sovrapposizioni di ricerca. visto che mentre scrivi avviene la ricerca, con questo piccolo tips, l'utente visualizzerà solo l'ultima ricerca effettuata, e non quella con l'ajax piu lento
                    if(now_id_ricerca==id_ricerca){
                        let tempDiv = $('<div>').html(esito.view);
                        if(code=='open_default_search_result'){
                            open_default_search_result = esito.view;
                        }

                        let html_article = tempDiv.find('#article').html();
                        let html_news = tempDiv.find('#news').html();
                        $("#search_result_list_article").html(html_article);
                        $("#search_result_list_news").html(html_news);
                        tempDiv.remove();

                        if (esito.success) {
                            $(".show_all_products").removeClass("d-none");
                            $("#artibleNotFoundBar").addClass("d-none");
                        } else {
                            $("#artibleNotFoundBar").removeClass("d-none");
                            $(".show_all_products").addClass("d-none");
                        }
                    }
                });
        }
        return true;
	}

	//Visualizza tutti i risultati
    $('body').on('click', '.show_all_products', function () {
        let code = $('input[name="search"]').val();

        //Se la ricerca è vuota, porta alle novità, altrimenti ai risultati impaginati
        if(code==''){
            location.href = "/" + brand_header + "/products-showcase";
        } else {
            location.href = "/" + brand_header + "/all-search-result/" + code;
        }
    })

    $('body').on('keyup', 'input[name="search"]', function (e) {
        let elem = $(this);
        let code = $(this).val();
        if (parseInt(code.length) <= 1) {
            e.preventDefault();
            return false;
        }
        search(code);
    });

    // Apri la modale della ricerca
    $(".open_search_menu").click(function() {
        search("open_default_search_result");
        $('input[name="search"]').val('');
        $('#search_full_screen').fadeIn();
        $('#search_overlay').fadeIn();
        $("body").addClass("modal-open"); // Aggiungi la classe per bloccare lo scroll
        // Aggiungi il focus all'input
        setTimeout(function() {
            $('input[name="search"]').focus();
        }, 500);
    });

    // Chiudi la modale della ricerca
    $(".close_search_menu").click(function() {
        $('#search_full_screen').fadeOut();
        $('#search_overlay').fadeOut();
        $("body").removeClass("modal-open"); // Rimuovi la classe per riattivare lo scroll
        $("#search_result_list_article").html('');
        $("#search_result_list_news").html('');
    });

    //Utilizza il suggerimento come ricerca
    $(".suggerimento").click(function(){
        let search_value = $(this).text().trim();
        $('input[name="search"]').val(search_value);
        search(search_value);
    });

})
