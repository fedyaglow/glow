function calcola(q) {
    var prezzo = $('#costo').val();
    return parseInt(q) * parseFloat(prezzo);
}

function calcolatrice(qta) {
    parseInt(qta);
    if (qta > 100) qta = 100;
    if (qta <= 0) qta = 1;

    //$('#qta').val(qta);
    $('.quantity').val(qta);

    let prezzo_c = parseFloat($('#prezzo_consulente').val());
    let prezzo_bottom = parseFloat($('#bottom_price').val());
    let p_pubb = parseFloat($('#prezzo_pubblico').val());

    let tot_cons = parseFloat(qta * prezzo_c);
    let tot_pubb = parseFloat(qta * p_pubb);
    let guad_riv = parseFloat(tot_pubb - tot_cons);
    let tot_bottom = parseFloat(qta * prezzo_bottom);

    $('#p_cons_euro').html(tot_cons.toFixed(2).toString().replace('.', ','));
    $('#p_pubb_euro').html(tot_pubb.toFixed(2).toString().replace('.', ','));
    $('#guad_euro').html(guad_riv.toFixed(2).toString().replace('.', ','));
    $('.bottom-price-container').html(tot_bottom.toFixed(2).toString().replace('.', ','));

    if ($('#p_pubb_valuta') != undefined) {
        prezzo_c = parseFloat($('#prezzo_consulente_valuta').val());
        p_pubb = parseFloat($('#prezzo_pubblico_valuta').val());

        tot_cons = parseFloat(qta * prezzo_c);
        tot_pubb = parseFloat(qta * p_pubb);
        guad_riv = parseFloat(tot_pubb - tot_cons);

        $('#p_cons_valuta').html(tot_cons.toFixed(2).toString().replace('.', ','));
        $('#p_pubb_valuta').html(tot_pubb.toFixed(2).toString().replace('.', ','));
        $('#guad_valuta').html(guad_riv.toFixed(2).toString().replace('.', ','));
    }

    if (qta == 1) {
        // $("#minus").addClass("disabled");
        $(".minus").addClass("disabled");
    } else {
        // $("#minus").removeClass("disabled");
        $(".minus").removeClass("disabled");
    }
    if (qta >= 100) {
        // $("#plus").addClass("disabled");
        $(".plus").addClass("disabled");
    } else {
        // $("#plus").removeClass("disabled");
        $(".plus").removeClass("disabled");
    }
}

