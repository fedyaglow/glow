$(document).ready(function () {
    const $scrollableDiv = $('#scrollable-div');
    const $scrollLeftButton = $('#scroll-miniature-left');
    const $scrollRightButton = $('#scroll-miniature-right');

    if (!$scrollableDiv.length) return;

    setTimeout(function () {
        if ($scrollableDiv[0].scrollWidth <= $scrollableDiv[0].clientWidth) {
            $scrollLeftButton.hide();
            $scrollRightButton.hide();
        }
    }, 500);

    function updateButtonState() {
        // Check if the div is scrolled to the left
        if ($scrollableDiv.scrollLeft() === 0) {
            $scrollLeftButton.css('opacity', 0.3); // Disable left button
        } else {
            $scrollLeftButton.css('opacity', 1); // Enable left button
        }

        // Check if the div is scrolled to the right
        if ($scrollableDiv.scrollLeft() + $scrollableDiv[0].clientWidth + 1 >= $scrollableDiv[0].scrollWidth) {
            $scrollRightButton.css('opacity', 0.3); // Disable right button
        } else {
            $scrollRightButton.css('opacity', 1); // Enable right button
        }
    }

    $scrollRightButton.on('click', function () {
        $scrollableDiv.animate({
            scrollLeft: '+=200' // Scroll 200 pixels to the right
        }, 'smooth'); // Smooth scrolling
    });

    $scrollLeftButton.on('click', function () {
        $scrollableDiv.animate({
            scrollLeft: '-=200' // Scroll 200 pixels to the left
        }, 'smooth'); // Smooth scrolling
    });

    // Listen for scroll events to update button state
    $scrollableDiv.on('scroll', updateButtonState);

});
