}

function add_cart_custom(id_art, qta) {
    // console.log(id_art);
    // console.log(qta);

    // Aggiorna visualmente il numero di articoli nel carrello
    const actualQty = parseInt($(".fast_cart_items").text(), 0);
    $(".fast_cart_items").text(actualQty + qta);

    // Chiamata AJAX per aggiungere al carrello
    $.get("/add_to_cart", { id_art, qta })
        .done(function (esito) {
            var hasShippingBar = $("#shipping-progress-root").length > 0;
            if (hasShippingBar && typeof reload_shipping_progress_bar === 'function') {
                reload_shipping_progress_bar();
            }

            const winWidth = $(window).width();
            if (winWidth <= 850) {
                $('#alert_mobile').addClass('show');

                if (winWidth > 320) {
                    $('#bottombar_sm').hide();
                }

                setTimeout(() => {
                    $('#alert_mobile').removeClass('show');

                    if (winWidth > 320) {
                        $('#bottombar_sm').show();
                    }
                }, 1000)
            } else {
                const msg = esito.err || esito.success;
                $("#txtAdded").text(msg);
                $("#modalAdded").show();
                $("#modalFavorites").hide();
                setTimeout(function () {
                    $("#modalAdded").hide();
                }, 3500);
            }

            //$('.qty-div .quantity').val(1);

        })
        .fail(function () {
            quick_alert("Generic error", "warning");
        });
}

