$(function () {
    var owlBig = $('#big-carousel');
    var totalItems = owlBig.find('.item').length; // Ottieni il numero di elementi nel carosello

    var navEnabled = totalItems > 1;  // Imposta nav a true se ci sono più di 1 elemento, altrimenti a false
    var navText = navEnabled ? [
        '<i class="fas fa-chevron-left fa-lg" alt="prev"></i>',
        '<i class="fas fa-chevron-right fa-lg" alt="next"></i>'
    ] : []; // Se nav è true, definisci navText; altrimenti, non definire navText

    // Inizializza Owl Carousel per il carosello
    owlBig.owlCarousel({
        loop: false,
        autoplay: false,
        autoplayHoverPause: true,
        margin: 0,
        nav: navEnabled,
        navText: navText,
        responsive: {
            0: {
                items: 1,
                dots: totalItems > 1,
                navs: false,
                navText: '',
            },
            480: {
                items: 1,
                dots: totalItems > 1,
                navs: false,
                navText: '',
            },
            768: {
                items: 1,
                dots: totalItems > 1,
                navs: false,
                navText: '',
            },
            1023: {
                items: 1,
                dots: false
            },

        },
    });

    function setActiveThumbnail(index) {
        const $allMiniatures = $(".miniatura .miniature");
        $allMiniatures.removeClass("active-thumbnail");

        const $activeThumbnail = $allMiniatures.filter('[data-index="' + index + '"]').first();
        if (!$activeThumbnail.length) return;

        $activeThumbnail.addClass("active-thumbnail");

        const $scrollableDiv = $('#scrollable-div');
        if (!$scrollableDiv.length) return;

        const scrollableDiv = $scrollableDiv[0];
        const activeThumbnail = $activeThumbnail[0];
        const activeWrapper = activeThumbnail.closest('.img-wrapper') || activeThumbnail;
        const currentScrollLeft = scrollableDiv.scrollLeft;
        const currentViewportRight = currentScrollLeft + scrollableDiv.clientWidth;
        const thumbnailLeft = activeWrapper.offsetLeft;
        const thumbnailRight = thumbnailLeft + activeWrapper.clientWidth;

        if (thumbnailLeft >= currentScrollLeft && thumbnailRight <= currentViewportRight) {
            return;
        }

        const targetScrollLeft = thumbnailLeft - ((scrollableDiv.clientWidth - activeWrapper.clientWidth) / 2);
        const maxScrollLeft = scrollableDiv.scrollWidth - scrollableDiv.clientWidth;
        const boundedScrollLeft = Math.max(0, Math.min(targetScrollLeft, maxScrollLeft));

        $scrollableDiv.stop().animate({ scrollLeft: boundedScrollLeft }, 220);
    }

    // Gestisci il click sulle miniature per cambiare l'immagine del carosello
    $(".miniatura").on("click", ".miniature", function () {
        var index = $(this).data("index");
        owlBig.trigger("to.owl.carousel", [index, 300]);
    });

    // Gestisci la classe "active" e il bordo per la miniatura attiva
    owlBig.on('changed.owl.carousel', function (event) {
        var currentIndex = event.item.index;
        setActiveThumbnail(currentIndex);
    });

    // Inizializza la prima miniatura con il bordo
    setActiveThumbnail(0);
});

function bottomBarHandle(buttonAdd, body) {
    let bottomBar = document.getElementById('bottombar_desk');
    let larghezza = window.innerWidth;
    let minScrollY = 0;
    if (larghezza <= 320) {
        minScrollY = minScrollY * 2;
        bottomBar = document.getElementById('bottombar_xs');
    } else if (larghezza > 320 && larghezza <= 850) {
        bottomBar = document.getElementById('bottombar_sm');
        minScrollY = window.innerHeight;
    } else {
        bottomBar = document.getElementById('bottombar_desk');
    }

    if (buttonAdd && bottomBar) {
        const observer = new IntersectionObserver(
            (entries) => {
                entries.forEach(entry => {
                    const hasScrolledEnough = window.scrollY > minScrollY;

                    if (entry.isIntersecting && hasScrolledEnough) {
                        bottomBar.classList.remove('show');
                        bottomBar.classList.add('hide');
                        body.style.paddingBottom = '0';
                    } else if (!entry.isIntersecting && hasScrolledEnough) {
                        bottomBar.classList.remove('hide');
                        bottomBar.classList.add('show');
                        body.style.paddingBottom = '108px';
                    } else {
                        // Se non ha scrollato abbastanza, assicurati che la barra sia nascosta
                        bottomBar.classList.remove('show');
                        bottomBar.classList.add('hide');
                        body.style.paddingBottom = '0';
                    }
                });
            },
            {
                root: null,
                threshold: 0
            }
        );
        observer.observe(buttonAdd);
    }

    const btnAddBottom = document.getElementById('btnAddBottom');
    const qtyBottombar = document.getElementById('qty_bottombar')
    if (btnAddBottom && qtyBottombar) {
        const artId = btnAddBottom.getAttribute('data-id');
        btnAddBottom.addEventListener('click', () => {
            const qty = qtyBottombar.value;
            add_cart_custom(artId, qty);
        })
    }
}

document.addEventListener('DOMContentLoaded', () => {
    const buttonAdd = document.getElementById('txtAggiungi');
    const body = document.querySelector('body');

    // Visualizzazione menu APP
