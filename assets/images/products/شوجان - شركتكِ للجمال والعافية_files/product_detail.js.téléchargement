    });

    // Star rating functionality
    var $stars = $('.star-rating .fa-star');
    var confirmedRating = 0; // Variable to store the confirmed rating

    $stars.each(function () {
        const $star = $(this);

        $star.on('mouseover', function () {
            var currentValue = $star.data('value');
            $stars.each(function () {
                if ($(this).data('value') <= currentValue) {
                    $(this).addClass('filled');
                } else {
                    $(this).removeClass('filled');
                }
            });
        });

        $star.on('mouseout', function () {
            $stars.each(function () {
                // Only remove filled class if no rating has been confirmed
                if (confirmedRating === 0) {
                    $(this).removeClass('filled');
                } else {
                    // Keep the confirmed rating filled
                    if ($(this).data('value') <= confirmedRating) {
                        $(this).addClass('filled');
                    } else {
                        $(this).removeClass('filled');
                    }
                }
            });
        });

        $star.on('click', function () {
            confirmedRating = $star.data('value'); // Store the confirmed rating
