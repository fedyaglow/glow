            const breadDesk = document.querySelector('.breadcrumb-custom');
            if (breadDesk) breadDesk.remove();

            // Creo il breadcrumb dell'app
            const bread = document.createElement('div');
            bread.classList.add('breadcrumb-custom');
            if (breadContent) {
                bread.appendChild(breadContent);
            }
            colApp.innerHTML = "";
            colApp.appendChild(bread);
        }
    }

    if (!buttonAdd || !body) return;

    window.addEventListener('load', () => {
        bottomBarHandle(buttonAdd, body);
    })

    window.addEventListener('resize', () => {
        bottomBarHandle(buttonAdd, body);
    })

})

document.addEventListener('DOMContentLoaded', () => {
    // Product Video Handler
    const videos = document.querySelectorAll('.product-video');
    if (!videos.length) return;

    const observer = new IntersectionObserver(
        (entries) => {
            entries.forEach((entry) => {
                const video = entry.target;
                if (entry.isIntersecting) {
                    const playPromise = video.play();
                    if (playPromise !== undefined) {
                        playPromise.catch(() => { });
                    }
                } else {
                    video.pause();
                    video.muted = true;
                }
            });
        },
        {
            threshold: 0.5
        }
    );

    videos.forEach((video) => {
        const videoSrc = video.getAttribute('data-video-src');
        if (!videoSrc) return;

        video.muted = true;
        video.playsInline = true;

        const isHlsSource = videoSrc.indexOf('.m3u8') !== -1;
        if (isHlsSource && typeof Hls !== 'undefined' && Hls.isSupported()) {
            const hls = new Hls();
            hls.loadSource(videoSrc);
            hls.attachMedia(video);
        } else if (video.canPlayType('application/vnd.apple.mpegurl') || !isHlsSource) {
            video.src = videoSrc;
        }

        observer.observe(video);
    });
})
