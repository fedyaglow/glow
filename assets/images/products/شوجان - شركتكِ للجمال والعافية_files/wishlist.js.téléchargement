//Wishlist
function openFavModal(id, codice=null) {
    $.get("/add_remove_wishlist/" + id, function(esito) {
        const isAdded = esito.msg === 'added';

        // Toggle heart icon
        // $('.icon-heart').toggleClass('active', isAdded);

        $('.icon-heart').each(function(){
            if($(this).attr('data-id') == id) {
                $(this).toggleClass('active', isAdded);
            }
        })

        // Cambio il valore nel pulsante con l'occhiolino se esiste
        $('.eye-button').each(function(){
            if($(this).attr('alt2') == id) {
                $(this).attr('data-inWishlist', isAdded ? 1 : 0);
            }
        })

        //Elimino la card con il prodotto eliminato dalla wishlist
        var element = $('#wish_list div:has([data-id="' + id + '"])');
        if (element.length) {
            element.fadeOut(500, function() {
                $(this).remove();
            });
        }


        let text_custom = isAdded ? txtAggiunto : txtRimosso;
        if(codice!=null) {
            text_custom = text_custom.replace('product_code', codice);
        }

        // Imposta testo dinamico e mostra il modal
        $('#txtFav').text(text_custom);
        $('#modalFavorites').show();
        $("#modalAdded").hide();

        setTimeout(function() {
            $("#modalFavorites").hide();
        }, 3500);
    });
}

function openAuthModal() {
    $('#modalAuth').fadeIn();
    setTimeout(function(){
        $("#modalAuth").fadeOut();
    }, 3000)
}

$(function(){


    $('body').on('click','.icon-heart',function(e){
        e.stopPropagation();
        let id = $(this).attr('data-id');
        let code = $(this).attr('data-code');
        openFavModal(id, code);
    });

});

